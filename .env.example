# Nunca envie o arquivo .env real ao GitHub.
# Copie este arquivo para .env e substitua os valores abaixo apenas no seu computador.

WAREHOUSE_PASSWORD=defina_uma_senha_forte_aqui
SESSION_SECRET=gere_uma_chave_longa_e_aleatoria

# Desenvolvimento local
DATABASE_URL=sqlite:///./inventory.db

# Na Railway, a variável DATABASE_URL será configurada no painel com:
# sqlite:////data/inventory.db
# Em produção (Railway), defina como true para proteger o cookie de sessão.
COOKIE_SECURE=false
